---
import type { Trabajo } from '../../data/trabajos';
import { trabajos } from '../../data/trabajos';
import CasoExitoCard from './CasoExitoCard';

interface Props {
  items?: Trabajo[];
  showTitle?: boolean;
}

const { items = trabajos, showTitle = true } = Astro.props;
---

{showTitle && (
  <div class="text-center mb-16">
    <h2 class="font-display text-4xl md:text-5xl font-bold text-primary mb-4">
      Galería de Casos de Éxito
    </h2>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      Descubre todos los proyectos que hemos realizado. Empresas y clientes que confiaron en nosotros. Resultados que hablan por sí solos.
    </p>
  </div>
)}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {items.map((caso, idx) => (
    <CasoExitoCard client:load caso={caso} index={idx} />
  ))}
</div>

<style>
  div[style] {
    animation: slideInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
