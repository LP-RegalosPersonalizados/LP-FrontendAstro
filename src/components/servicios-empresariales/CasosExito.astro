---
import type { Trabajo } from '../../data/trabajos';
import CasoExitoCard from '../trabajos/CasoExitoCard';

interface Props {
  maxItems?: number;
  trabajos: Trabajo[];
}

const { maxItems = 6, trabajos } = Astro.props;
const worksByCategory = trabajos.filter(t => t.category === 'Corporativo').slice(0, maxItems);
---

<section class="section-padding bg-gradient-to-br from-gray-50 to-white" id="casos-exito">
  <div class="container-main">
    <div class="text-center mb-16">
      <h2 class="font-display text-4xl md:text-5xl font-bold text-primary mb-4">
        Nuestros Casos de Éxito
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Empresas y clientes que confiaron en nosotros. Resultados que hablan por sí solos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {worksByCategory.map((caso, idx) => (
        <CasoExitoCard client:load caso={caso} index={idx} />
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 pt-12 border-t border-neutral-light text-center">
      <p class="text-gray-600 mb-6 text-lg">
        ¿Listo para ser parte de nuestros casos de éxito?
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/trabajos-previos"
          class="inline-block px-8 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-all duration-300 hover:scale-105"
          aria-label="Ver galería completa de casos de éxito"
        >
          Ver Casos de Éxito Completo →
        </a>
        <a
          href="https://wa.me/59162699702"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent/90 transition-all duration-300"
        >
          Solicitar Información
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  div[style] {
    animation: slideInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
