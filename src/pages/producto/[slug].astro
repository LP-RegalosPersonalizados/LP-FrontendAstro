---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductDetail from '../../components/productos/ProductDetail';
import ProductCard from '../../components/productos/ProductCard';
import { optimizeImage } from '../../utils/cloudinary';
export const prerender = true;

import { fetchProducts, getProductBySlug, getRelatedProducts } from '../../data/products';
import { fetchCategories, getCategoryLabel } from '../../data/categories';

export async function getStaticPaths() {
  const products = await fetchProducts();
  return products.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;

const product = await getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect('/404');
}

const categories = await fetchCategories();

const related = await getRelatedProducts(product, 3);

const siteUrl = 'https://www.recuerdoscompartidos.sarl';
const productUrl = `${siteUrl}/producto/${slug}`;

// Imagen principal optimizada + galería para schema
const productImages = [
  optimizeImage(product.image, { width: 800 }),
  ...(product.gallery ?? []).map((img) => optimizeImage(img, { width: 800 })),
];

// Fecha de validez de la oferta: +12 meses desde la fecha de build
const priceValidUntil = new Date(
  new Date().setFullYear(new Date().getFullYear() + 1)
).toISOString().slice(0, 10);

// Schema Product para SEO
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  'name': product.name,
  'description': product.description,
  'image': productImages,
  'url': productUrl,
  'sku': product.id,
  'brand': {
    '@type': 'Brand',
    'name': 'Recuerdos Compartidos'
  },
  'category': product.category,
  ...(product.price
    ? {
        'offers': {
          '@type': 'Offer',
          'url': productUrl,
          'priceCurrency': 'BOB',
          'price': product.price.toString(),
          'priceValidUntil': priceValidUntil,
          'itemCondition': 'https://schema.org/NewCondition',
          'availability': 'https://schema.org/InStock',
          'seller': {
            '@type': 'LocalBusiness',
            'name': 'Recuerdos Compartidos'
          },
          'areaServed': {
            '@type': 'Country',
            'name': 'Bolivia'
          }
        }
      }
    : {}),
};

// Schema BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Inicio',
      'item': `${siteUrl}/`
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Catálogo',
      'item': `${siteUrl}/catalogo`
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': getCategoryLabel(categories, product.category),
      'item': `${siteUrl}/categoria/${product.category}`
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'name': product.name,
      'item': productUrl
    }
  ]
};
---

<MainLayout
  title={product.name}
  description={`${product.description} Personalizado y hecho a tu medida en Santa Cruz de la Sierra. Cotizá por WhatsApp.`}
  keywords={`${product.name}, recuerdos compartidos Santa Cruz, ${product.category}, regalo personalizado Bolivia`}
  author="Recuerdos Compartidos"
  robots="index, follow"
  canonical={`https://www.recuerdoscompartidos.sarl/producto/${slug}`}
  ogImage={optimizeImage(product.image, { width: 1200, height: 630, format: 'jpg', force: true })}
>
  <section class="section-padding">
    <div class="container-main">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-10" aria-label="Navegación de migas de pan">
        <a href="/" class="hover:text-primary transition-colors duration-200">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/catalogo" class="hover:text-primary transition-colors duration-200">Catálogo</a>
        <span aria-hidden="true">/</span>
        <a href={`/categoria/${product.category}`} class="hover:text-primary transition-colors duration-200">
          {getCategoryLabel(categories, product.category)}
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-gray-700 font-medium" aria-current="page">{product.name}</span>
      </nav>

      <!-- Product detail -->
      <ProductDetail product={product} client:load />

      <!-- Related products -->
      {related.length > 0 && (
        <div class="mt-20">
          <h2 class="font-display font-bold text-primary text-2xl mb-8">
            También te puede gustar
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((p) => (
              <ProductCard product={p} client:visible />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Schema Product -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline />

  <!-- Schema Breadcrumb -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
</MainLayout>
