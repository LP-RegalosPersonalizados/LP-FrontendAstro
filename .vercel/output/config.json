{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/catalogo\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/producto\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/servicios-empresariales\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/trabajos-previos\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		},
		{
			"src": "/.*",
			"dest": "/404.html",
			"status": 404
		}
	]
}